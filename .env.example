# Current protected production path
VITE_COMMERCE_MODE=legacy
VITE_COMMERCE_API_BASE=https://gear.aerovista.us
VITE_COMMERCE_CATALOG_URL=https://gear.aerovista.us/square_products_latest.json
VITE_CATALOG_IMAGE_BASE=https://gear.aerovista.us/img

# On apparel.aerovista.us, API/catalog requests become same-origin once the
# staged Cloudflare apparel commerce edge is promoted.

# Future additive API cutover (leave legacy until release gates are approved)
# VITE_COMMERCE_MODE=v1
# VITE_COMMERCE_V1_BASE=https://api.aerovista.us
# VITE_COMMERCE_CHECKOUT_ORIGIN=https://apparel.aerovista.us


# Customer account benefit rollout controls.
# Exposure flags only: authorization remains server-side.
VITE_APPAREL_ACCOUNT_HUB=0
VITE_APPAREL_ACCOUNT_ORDERS=0
VITE_APPAREL_ACCOUNT_SAVED=0
VITE_APPAREL_ACCOUNT_FIT=0
VITE_APPAREL_ACCOUNT_BENEFITS=0
VITE_APPAREL_RESTOCK_ALERTS=0
